  {
    "id": "go",
    "name": "Go",
    "detect": {
      "commands": [
        "go"
      ],
      "versionArgs": [
        "version"
      ]
    },
    "install": {
      "windows": {
        "url": "https://go.dev/dl/",
        "steps": [
          "Dans un terminal : winget install GoLang.Go",
          "Cliquez sur « Revérifier » : SynAck relit le PATH de Windows, inutile de le rouvrir."
        ]
      },
      "macos": {
        "url": "https://go.dev/dl/",
        "steps": [
          "Dans un terminal : brew install go",
          "Cliquez sur « Revérifier »."
        ]
      },
      "linux": {
        "url": "https://go.dev/dl/",
        "steps": [
          "Debian/Ubuntu : sudo apt install golang-go",
          "Ou installez la dernière version depuis go.dev/dl.",
          "Cliquez sur « Revérifier »."
        ]
      }
    },
    "run": {
      "file": "main.go",
      "compile": {
        "args": [
          "build",
          "-o",
          "{out}",
          "main.go"
        ]
      },
      "exec": {
        "program": "{out}",
        "args": []
      }
    }
  },
  {
    "id": "rust",
    "name": "Rust",
    "detect": {
      "commands": [
        "rustc"
      ],
      "versionArgs": [
        "--version"
      ]
    },
    "install": {
      "windows": {
        "url": "https://rustup.rs/",
        "steps": [
          "Dans un terminal : winget install Rustlang.Rustup",
          "Il faut aussi les Build Tools de Visual Studio (composant « Développement Desktop en C++ »).",
          "Cliquez sur « Revérifier » : SynAck relit le PATH de Windows, inutile de le rouvrir."
        ]
      },
      "macos": {
        "url": "https://rustup.rs/",
        "steps": [
          "Dans un terminal : curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh",
          "Cliquez sur « Revérifier »."
        ]
      },
      "linux": {
        "url": "https://rustup.rs/",
        "steps": [
          "Dans un terminal : curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh",
          "Cliquez sur « Revérifier »."
        ]
      }
    },
    "run": {
      "file": "main.rs",
      "compile": {
        "args": [
          "--edition=2024",
          "main.rs",
          "-o",
          "{out}"
        ]
      },
      "exec": {
        "program": "{out}",
        "args": []
      }
    }
  }
]