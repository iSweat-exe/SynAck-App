          "main.js"
        ]
      }
    }
  },
  {
    "id": "c",
    "name": "C",
    "detect": {
      "commands": [
        "gcc",
        "clang",
        "cc"
      ],
      "versionArgs": [
        "--version"
      ]
    },
    "install": {
      "windows": {
        "url": "https://www.msys2.org/",
        "steps": [
          "Installez MSYS2 : winget install MSYS2.MSYS2",
          "Dans le terminal « MSYS2 UCRT64 » : pacman -S mingw-w64-ucrt-x86_64-gcc",
          "Ajoutez C:\\msys64\\ucrt64\\bin à la variable d'environnement PATH.",
          "Cliquez sur « Revérifier » : SynAck relit le PATH de Windows, inutile de le rouvrir."
        ]
      },
      "macos": {
        "url": "https://developer.apple.com/xcode/resources/",
        "steps": [
          "Dans un terminal : xcode-select --install",
          "Cliquez sur « Revérifier »."
        ]
      },
      "linux": {
        "url": "https://gcc.gnu.org/",
        "steps": [
          "Debian/Ubuntu : sudo apt install build-essential",
          "Fedora : sudo dnf install gcc",
          "Cliquez sur « Revérifier »."
        ]
      }
    },
    "run": {
      "file": "main.c",
      "compile": {
        "args": [
          "main.c",
          "-o",
          "{out}"
        ]
      },
      "exec": {
        "program": "{out}",
        "args": []
      }
    }
  },
