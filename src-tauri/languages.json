[
  {
    "id": "python",
    "name": "Python",
    "detect": {
      "commands": [
        "python3",
        "python",
        "py"
      ],
      "versionArgs": [
        "--version"
      ]
    },
    "install": {
      "windows": {
        "url": "https://www.python.org/downloads/",
        "steps": [
          "Dans un terminal : winget install --id Python.Python.3.14",
          "Ou téléchargez l'installeur sur python.org et cochez « Add python.exe to PATH ».",
          "Cliquez sur « Revérifier » : SynAck relit le PATH de Windows, inutile de le rouvrir."
        ]
      },
      "macos": {
        "url": "https://www.python.org/downloads/",
        "steps": [
          "Dans un terminal : brew install python",
          "Cliquez sur « Revérifier »."
        ]
      },
      "linux": {
        "url": "https://www.python.org/downloads/",
        "steps": [
          "Debian/Ubuntu : sudo apt install python3",
          "Fedora : sudo dnf install python3",
          "Cliquez sur « Revérifier »."
        ]
      }
    },
    "run": {
      "file": "main.py",
      "exec": {
        "program": "{tool}",
        "args": [
          "-u",
          "main.py"
        ]
      },
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    }
  },
  {
    "id": "javascript",
    "name": "JavaScript (Node.js)",
    "detect": {
      "commands": [
