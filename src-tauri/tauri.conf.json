{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SynAck",
  "version": "0.1.0",
  "identifier": "app.synack.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SynAck",
        "width": 1360,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://avatars.githubusercontent.com https://cdn.discordapp.com; font-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "SynAck",
    "homepage": "https://github.com/iSweat-exe/SynAck-App"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBMDU2REVDQUVFMjZBMUYKUldRZmF1S3U3RzBGYWtjdlJLN09UeU1LVXlWT2V3Y2R0bExsUkRrMGU4V0lDaEdrTm5HNFhueEIK",
      "endpoints": [
        "https://github.com/iSweat-exe/SynAck-App/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
